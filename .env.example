# GitHub personal access token (needs repo + write:discussion scopes)
GITHUB_TOKEN=ghp_your_token_here

# Your fork: owner/repo
GITHUB_REPO=Mauricec95/superset

# Secret you set when configuring the GitHub webhook
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Devin API key from https://app.devin.ai/settings/api
DEVIN_API_KEY=your_devin_api_key_here

# Devin API base URL (default is correct for most users)
DEVIN_API_BASE=https://api.devin.ai/v1

# How often (in seconds) to poll Devin for session status
POLL_INTERVAL_SECONDS=30

# The GitHub issue label that triggers Devin
DEVIN_TRIGGER_LABEL=devin-fix

# Path inside the container where SQLite DB is stored (leave as-is)
DATABASE_PATH=/data/sessions.db
